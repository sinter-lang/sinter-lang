{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sinter",
  "scopeName": "source.sinter",
  "fileTypes": ["snt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#definitions" },
    { "include": "#keywords" },
    { "include": "#macros" },
    { "include": "#paths" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sinter",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.sinter",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.sinter",
      "begin": "(#\\[)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.attribute.sinter" },
        "2": { "name": "entity.name.function.attribute.sinter" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.attribute.sinter" }
      },
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.sinter" },
            "2": { "name": "keyword.operator.assignment.sinter" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.sinter",
      "begin": "\"",
      "end": "\""
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sinter",
          "match": "\\b0x[0-9a-fA-F](_*[0-9a-fA-F])*(_[ui][0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.binary.sinter",
          "match": "\\b0b[01](_*[01])*(_[ui][0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.sinter",
          "match": "\\b[0-9](_*[0-9])*(_[ui][0-9]+)?\\b"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.sinter" },
            "2": { "name": "entity.name.function.sinter" }
          }
        },
        {
          "match": "\\b(struct|enum|impl)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.sinter" },
            "2": { "name": "entity.name.type.sinter" }
          }
        },
        {
          "match": "\\b(mod)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.mod.sinter" },
            "2": { "name": "entity.name.namespace.sinter" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.const.sinter" },
            "2": { "name": "variable.other.constant.sinter" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sinter",
          "match": "\\b(if|else|match|yield)\\b"
        },
        {
          "name": "keyword.other.sinter",
          "match": "\\b(let|use|mod|const|fn|struct|enum|impl|gen)\\b"
        },
        {
          "name": "storage.modifier.sinter",
          "match": "\\b(pub|pipeline|multiplex)\\b"
        },
        {
          "match": "\\b(as)\\s+([ui][0-9]+(?:\\.[0-9]+)?|[A-Za-z_][A-Za-z0-9_]*)\\s+(sat|wrap|trunc|round)\\b",
          "captures": {
            "1": { "name": "keyword.operator.cast.sinter" },
            "2": { "name": "storage.type.sinter" },
            "3": { "name": "keyword.operator.cast.mode.sinter" }
          }
        },
        {
          "name": "keyword.operator.cast.sinter",
          "match": "\\bas\\b"
        },
        {
          "name": "variable.language.self.sinter",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.language.sinter",
          "match": "\\b(Some|None)\\b"
        }
      ]
    },
    "macros": {
      "name": "support.function.macro.sinter",
      "match": "\\b(assert|debug_assert|include_hex)!"
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.sinter",
          "match": "\\b[ui][0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "support.type.sinter",
          "match": "\\b(Option|mem|rom|fifo|ring|flow|Sender|Receiver|Push|sync|pulse|mailbox|async_fifo)(?=\\s*<)"
        },
        {
          "name": "entity.name.type.sinter",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.sinter" },
            "2": { "name": "entity.name.function.method.sinter" }
          }
        },
        {
          "name": "entity.name.function.call.sinter",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "paths": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.sinter" },
        "2": { "name": "punctuation.separator.namespace.sinter" },
        "3": { "name": "variable.other.enummember.sinter" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.sinter",
          "match": "==|!=|<=|>=|=>"
        },
        {
          "name": "keyword.operator.bitwise.shift.sinter",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.sinter",
          "match": "->|[@|^&<>+\\-*!~?=]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.namespace.sinter", "match": "::" },
        { "name": "punctuation.separator.comma.sinter", "match": "," },
        { "name": "punctuation.terminator.sinter", "match": ";" },
        { "name": "punctuation.accessor.sinter", "match": "\\." }
      ]
    }
  }
}
