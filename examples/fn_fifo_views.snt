// CHAN3 (DESIGN §6.11 / §9.8): a `fifo`'s producer and consumer, each a
// function that sees only its directional view. The producer can push only
// through its `Sender`, whose `offer` refuses the word when the queue is full,
// so the lossless queue can't be overfilled.
struct Queue {
    pub q: fifo<u8, 4>,
}

// The producer: offer the incoming word, if any. A full queue refuses it.
fn produce(tx: Sender<u8, 4>, incoming: Option<u8>) -> Push<u8> {
    tx.offer(incoming)
}

// The consumer: take the head when asked and the queue isn't empty.
fn consume(rx: Receiver<u8, 4>, take: u1) -> u1 {
    if rx.is_empty() == 1 { 0 } else { take }
}

impl Queue {
    #[clock(domain = sys)]
    fn tick(self, incoming: Option<u8>, take: u1) -> (Queue, Option<u8>) {
        let push = produce(self.q.sender(), incoming);
        let pop = consume(self.q.receiver(), take);
        (Queue { q: self.q.next(push, pop) }, self.q.receiver().front())
    }
}
