# =============================================================================
# The go_board_counter.snt design on an ECP5 (LPF1, DESIGN §9.15).
#
# The same pin-map format as go_board.pins, with two ECP5-only extras:
#
#     set_io <site> <dir> <path> [low] [io_type=<std>] [freq=<n>MHz]
#
#   io_type= : the pin's I/O standard (an LPF `IOBUF ... IO_TYPE=`)
#   freq=    : a clock pin's frequency (an LPF `FREQUENCY PORT`)
#
# Build the wrapper and LPF with
#
#     sinter build examples/go_board_counter.snt --pins examples/go_board_ecp5.pins \
#         --constraints build/go_board_ecp5.lpf
#
# NOTE: the sites follow a ULX3S (LFE5U-25F, CABGA381): the 25 MHz oscillator,
# two buttons, and 14 GPIOs for the two seven-segment digits. Check them
# against your own board before flashing it.
# =============================================================================

set_io G2  clock  sys       io_type=LVCMOS33 freq=25MHz
set_io R1  in     btn.inc   io_type=LVCMOS33
set_io T1  in     btn.dec   io_type=LVCMOS33
set_io B11 out    seg[0][0] low io_type=LVCMOS33
set_io C11 out    seg[0][1] low io_type=LVCMOS33
set_io A10 out    seg[0][2] low io_type=LVCMOS33
set_io A11 out    seg[0][3] low io_type=LVCMOS33
set_io A9  out    seg[0][4] low io_type=LVCMOS33
set_io B10 out    seg[0][5] low io_type=LVCMOS33
set_io B9  out    seg[0][6] low io_type=LVCMOS33
set_io C10 out    seg[1][0] low io_type=LVCMOS33
set_io A7  out    seg[1][1] low io_type=LVCMOS33
set_io A8  out    seg[1][2] low io_type=LVCMOS33
set_io C8  out    seg[1][3] low io_type=LVCMOS33
set_io B8  out    seg[1][4] low io_type=LVCMOS33
set_io C6  out    seg[1][5] low io_type=LVCMOS33
set_io C7  out    seg[1][6] low io_type=LVCMOS33
