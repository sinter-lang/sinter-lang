// ROM1: a read-only lookup-table ROM (DESIGN §6.6 / §6.9 / §9.7).
//
// `rom<u8, 8>` is an 8-deep, 8-bit-wide read-only memory — a `mem` with no write
// port, whose contents are fixed at compile time (here an inline array literal of
// squares). Its interface is `mem` minus the write:
//   - `value()` reads the read-data register — the word addressed LAST cycle
//     (a 1-cycle, `Static(1)` read);
//   - `next(addr)` is the transition (schedule a read of `addr`), threaded into
//     the tail `Self { lut }`. There is no write to drive — only the read
//     cursor advances.
struct Squares {
    lut: rom<u8, 8> = [0, 1, 4, 9, 16, 25, 36, 49],
}

impl Squares {
    #[clock(domain = sys)]
    fn tick(self, addr: u3) -> (Squares, u8) {
        let v = self.lut.value();
        (Squares { lut: self.lut.next(addr) }, v)
    }
}
