# =============================================================================
# ASPIRATIONAL pin map for go_board_counter.snt — Nandland Go Board (iCE40 HX1K).
#
# Format (PCF-flavored superset; see DESIGN.md §7.2 for the Sinter->Verilog->
# Yosys->nextpnr flow this feeds):
#
#     set_io <pin#> <dir> <path> [low]
#
#   <dir>  : clock | in | out
#   <path> : resolves against the #[clock] tick signature
#              `btn.<field>`     -> an input parameter of `Top::tick`
#              `<field>[i]...`   -> a field of the root state `self` (a `Top`)
#            a trailing `[i]` indexes a bit; a leading `[i]` indexes an array.
#   low    : board signal is active-low; Sinter inverts at the pin boundary.
#
# The compiler uses this to synthesize a top-level Verilog wrapper (one port per
# pin) and to emit the concrete nextpnr PCF as a build artifact.
#
# NOTE: pin numbers/polarity transcribed from Nandland's go_board_constraints —
# verify against the official file before flashing real hardware.
# =============================================================================

set_io 15  clock  sys           # 25 MHz oscillator -> clock domain `sys`

# --- Switches (active-high: pressed reads 1) --------------------------------
set_io 53  in     btn.inc       # SW1: increment
set_io 51  in     btn.dec       # SW2: decrement

# --- Right digit (ones) = state field seg[0]; board "Segment1", active-low ---
set_io 3   out    seg[0][0] low # A
set_io 4   out    seg[0][1] low # B
set_io 93  out    seg[0][2] low # C
set_io 91  out    seg[0][3] low # D
set_io 90  out    seg[0][4] low # E
set_io 1   out    seg[0][5] low # F
set_io 2   out    seg[0][6] low # G

# --- Left digit (tens) = state field seg[1]; board "Segment2", active-low ----
set_io 100 out    seg[1][0] low # A
set_io 99  out    seg[1][1] low # B
set_io 97  out    seg[1][2] low # C
set_io 95  out    seg[1][3] low # D
set_io 94  out    seg[1][4] low # E
set_io 8   out    seg[1][5] low # F
set_io 7   out    seg[1][6] low # G
