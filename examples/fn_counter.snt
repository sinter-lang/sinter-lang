// Functional-surface counter (DESIGN §2.1).
//
// The state is a `struct` and one invocation of the `#[clock]` transition
// method is one cycle: `value` increments when `en` is high and holds
// otherwise, wrapping at the declared 8-bit width.
struct Counter {
    pub value: u8 = 0,
}

impl Counter {
    #[clock(domain = sys)]
    fn tick(self, en: u1) -> Counter {
        Counter {
            value: if en == 1 { (self.value + 1) as u8 wrap } else { self.value },
        }
    }
}
