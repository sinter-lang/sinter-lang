// Fixed-point rounding: round a Q4.8 input to Q4.4 (drop 4 fractional bits,
// round half up) with the `round` cast. Exercises fractional narrowing.
struct Round {
    pub y: i4.4 = 0,
}

impl Round {
    #[clock(domain = sys)]
    fn tick(self, x: i4.8) -> Round {
        Round { y: x as i4.4 round }
    }
}
