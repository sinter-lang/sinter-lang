// M1 multiplex oracle example (DESIGN §3.2/§3.3): a 2-phase dot product reusing
// ONE multiplier. `dot2` computes a0*b0 + a1*b1 over two phases (one yield); the
// two `*` uses fold onto a single shared multiplier (operand-muxed by phase),
// and `Top` owns the instance and advances it once per `#[clock]` tick. Result +
// valid are surfaced; with phase counter `ph` reset to 0, the result is valid one
// cycle after a datum enters (latency 1, throughput 1/2). All registers reset 0.

multiplex fn dot2(a0: u8, b0: u8, a1: u8, b1: u8) -> u17 {
    let p = (a0 * b0) as u17 wrap;     // phase 0: the (sole) multiplier
    yield;
    (p + (a1 * b1)) as u17 wrap        // phase 1: SAME multiplier, other operands
}

struct Top {
    // The desugarer rewrites this field type to the synthesized `dot2__mux`.
    inst: dot2,
}

impl Top {
    #[clock(domain = sys)]
    fn tick(self, a0: u8, b0: u8, a1: u8, b1: u8) -> (Top, (u17, u1)) {
        let (inst2, result, valid) = self.inst.advance(a0, b0, a1, b1, 1);
        (Top { inst: inst2 }, (result, valid))
    }
}
