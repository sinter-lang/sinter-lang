// PL3a free-running pipeline oracle example (DESIGN §3.1 / §9.3).
//
// `mac` computes (a*b)+c across two register stages (latency = 2 yields). All
// three operands enter in stage 0 so the wavefront stays coherent: the multiply
// result AND `c` are carried across the first `yield`, then the add result across
// the second. `Top` owns one instance and advances it once per `#[clock]` tick,
// always feeding a valid input (free-running). The result and its `valid` bit are
// surfaced as outputs; `valid` is 0 for the first 2 cycles (the fill latency),
// then 1, and the first valid result is (a0*b0)+c0.

pipeline fn mac(a: u8, b: u8, c: u16) -> u16 {
    // Stage 0: multiply, and carry `c` alongside the product. The casts pin the
    // carried register widths (PL3a requires an explicit cast on carried values).
    let prod = (a * b) as u16 wrap;
    yield;
    // Stage 1: accumulate — `prod` and `c` arrived together on the same wavefront.
    let sum = (prod + c) as u16 wrap;
    yield;
    sum
}

struct Top {
    // The desugarer rewrites this field type to the synthesized `mac__pipe`.
    inst: mac,
}

impl Top {
    #[clock(domain = sys)]
    fn tick(self, a: u8, b: u8, c: u16) -> (Top, (u16, u1)) {
        // Free-running: advance the pipeline once per cycle.
        let (inst2, result, valid) = self.inst.advance(a, b, c);
        // The clock root returns a 2-tuple; the outputs are its 2nd element.
        (Top { inst: inst2 }, (result, valid))
    }
}
