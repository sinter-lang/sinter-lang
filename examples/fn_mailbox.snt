// A multi-bit clock-domain crossing (DESIGN §6.7 / §9.14, CLK3).
//
// `mailbox<u8, fast, slow>` carries one word at a time with a req / ack
// handshake. The producer in `fast` pushes through the mailbox's `Sender`,
// which refuses a word until the previous one has been taken across. The
// consumer in `slow` reads it through the `Receiver` and pops it. Every word
// sent arrives exactly once, in order.
struct Link {
    #[domain(fast)]
    pub next_word: u8 = 1,
    #[domain(slow)]
    pub last: u8 = 0,
    #[domain(slow)]
    pub received: u8 = 0,
    mb: mailbox<u8, fast, slow>,
}

impl Link {
    #[clock(domain = fast, period = 3)]
    fn tick_fast(self, go: u1) -> Link {
        let tx = self.mb.sender();
        let push = if go == 1 { tx.try_push(self.next_word) } else { tx.no_push() };
        // Count up only when the word was accepted.
        let sent: u1 = if go == 1 & tx.is_full() == 0 { 1 } else { 0 };
        Link {
            next_word: if sent == 1 { (self.next_word + 1) as u8 wrap } else { self.next_word },
            last: self.last,
            received: self.received,
            mb: self.mb.send(push),
        }
    }

    #[clock(domain = slow, period = 4)]
    fn tick_slow(self, take: u1) -> Link {
        let rx = self.mb.receiver();
        let got: Option<u8> = match rx.front() {
            Some(w) => if take == 1 { Some(w) } else { None },
            None => None,
        };
        Link {
            next_word: self.next_word,
            last: match got { Some(w) => w, None => self.last },
            received: match got { Some(_) => (self.received + 1) as u8 wrap, None => self.received },
            mb: self.mb.recv(take),
        }
    }
}
