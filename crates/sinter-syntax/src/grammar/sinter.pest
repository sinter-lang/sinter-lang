// Sinter concrete grammar (.snt).
//
// This file is the normative PEG for the current language subset. Per DESIGN
// §7.1 the formal grammar is the spec/conformance oracle; this PEG also happens
// to be the literal parser for the MVP. Keep it the single source of truth for
// surface syntax and grow it alongside DESIGN.md.
//
// Two surfaces coexist here:
//   * the legacy `module { in/out/reg }` core (DESIGN calls it the legacy MVP
//     surface, slated to migrate) — every rule below the "LEGACY" banner is
//     frozen so the existing compiler/oracle path stays bit-for-bit identical;
//   * the functional surface (DESIGN §2.1): `struct` state + `impl` transition
//     methods + a `#[clock]` root — every `f_*` / `*_item` rule below the
//     "FUNCTIONAL" banner. This surface currently parses only; semantic checks
//     and lowering are a later milestone. See `examples/go_board_counter.snt`.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ ("//" ~ (!"\n" ~ ANY)*) | ("/*" ~ (!"*/" ~ ANY)* ~ "*/") }

// A compilation unit is any mix of legacy modules and functional items.
program = { SOI ~ (module | item)* ~ EOI }

// ===========================================================================
// LEGACY surface — frozen. Do not change the parse of any pre-existing module.
// ===========================================================================

// A module optionally declares the clock domain it belongs to. Default: `sys`.
clock_attr = { "#[" ~ "clock" ~ "(" ~ "domain" ~ "=" ~ ident ~ ")" ~ "]" }
module     = { clock_attr? ~ "module" ~ ident ~ "{" ~ body_item* ~ "}" }

body_item = _{ port_decl | reg_decl | let_decl | assign_stmt }

// Interface ports. `in` feeds the cycle; `out` is driven combinationally.
port_decl = { dir ~ ident ~ ":" ~ ty ~ ";" }
dir       = { "in" | "out" }

// A register: persistent state with a declared width and a reset value.
reg_decl = { "reg" ~ ident ~ ":" ~ ty ~ "=" ~ expr ~ ";" }

// A combinational wire (single-assignment by construction).
let_decl = { "let" ~ ident ~ (":" ~ ty)? ~ "=" ~ expr ~ ";" }

// Assignments: `<=` schedules a register's next-state; `=` drives an output.
assign_stmt = { ident ~ assign_op ~ expr ~ ";" }
assign_op   = { "<=" | "=" }

// Types: arbitrary-width unsigned (`uN`) and signed (`iN`).
ty = @{ ("u" | "i") ~ ASCII_DIGIT+ }

// Expression grammar, lowest precedence first.
// Every binary operator is a captured rule so the parser can read it uniformly
// as the alternating operand/op/operand sequence within each level.
expr     = { or_expr }
or_expr  = { xor_expr ~ (or_op ~ xor_expr)* }
xor_expr = { and_expr ~ (xor_op ~ and_expr)* }
and_expr = { eq_expr ~ (and_op ~ eq_expr)* }
eq_expr  = { rel_expr ~ (eq_op ~ rel_expr)* }
rel_expr = { add_expr ~ (rel_op ~ add_expr)* }
add_expr = { unary ~ (add_op ~ unary)* }
unary    = { unary_op* ~ primary }
primary  = { if_expr | literal | ident | "(" ~ expr ~ ")" }

if_expr    = { "if" ~ expr ~ block_expr ~ "else" ~ (if_expr | block_expr) }
block_expr = { "{" ~ expr ~ "}" }

// Binary/unary operators, shared by both surfaces.
or_op    = { "|" }
xor_op   = { "^" }
and_op   = { "&" }
eq_op    = { "==" | "!=" }
rel_op   = { "<=" | ">=" | "<" | ">" }
add_op   = { "+" | "-" }
mul_op   = { "*" }
unary_op = { "!" | "~" | "-" }

// Integer literals: decimal, `0x` hex, or `0b` binary, with `_` digit
// separators and an optional Rust-style width suffix (`_u7`, `_i16`). The
// suffix is currently parsed and validated but not represented in the AST
// (width assertion is a semantic concern; DESIGN §6.10). Untyped otherwise:
// width is resolved from context. A `_` separator must sit *between two
// digits* (so `1_` and `0b_1010` are rejected, unlike Rust).
//
// NOTE: this rule is shared with the legacy `module` surface. Extending it is a
// strict, backward-compatible *superset*: every previously-valid literal parses
// to the identical value, so the legacy parse path is unchanged on all existing
// programs — the legacy surface simply now also accepts the binary/separator/
// suffix forms. (Intentional; the legacy surface is slated to migrate anyway.)
literal      = @{ literal_body ~ literal_suffix? }
literal_body = {
      "0x" ~ ASCII_HEX_DIGIT ~ ("_"* ~ ASCII_HEX_DIGIT)*
    | "0b" ~ ASCII_BIN_DIGIT ~ ("_"* ~ ASCII_BIN_DIGIT)*
    | ASCII_DIGIT ~ ("_"* ~ ASCII_DIGIT)*
}
literal_suffix = { "_" ~ ("u" | "i") ~ ASCII_DIGIT+ }

// Identifiers, excluding reserved words. `self` is intentionally NOT reserved
// (it is a contextual keyword, matched only in parameter position), so it reads
// as an ordinary identifier inside expressions (`self.value`).
keyword = @{
    ("module" | "in" | "out" | "reg" | "let" | "if" | "else"
   | "struct" | "enum" | "impl" | "fn" | "match" | "const" | "as"
   | "mod" | "use" | "pub" | "pipeline" | "multiplex" | "yield")
    ~ !(ASCII_ALPHANUMERIC | "_")
}
ident   = @{ !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// ===========================================================================
// FUNCTIONAL surface (DESIGN §2.1) — parse-only for now.
// ===========================================================================

item = { use_item | mod_item | const_item | struct_item | enum_item | impl_item | fn_item }

// Visibility (DESIGN §10): items are private unless marked `pub`. Atomic with a
// trailing word boundary so `pubx` is an ordinary identifier, not `pub` + `x`.
vis = @{ "pub" ~ !(ASCII_ALPHANUMERIC | "_") }

// `[pub] use a::b::c;` — a `::`-path import with an optional trailing `*` glob;
// leading `self` / `super` / `root` are ordinary segments interpreted by the
// parser. (Boundary-checked `use` keyword; the kw token is dropped in the AST.)
use_item = { vis? ~ kw_use ~ use_path ~ ";" }
kw_use   = @{ "use" ~ !(ASCII_ALPHANUMERIC | "_") }
use_path = { use_seg ~ ("::" ~ use_seg)* }
use_seg  = { "*" | ident }

// `[pub] mod foo;` (external file `foo.snt`) or `mod foo { items }` (inline).
mod_item   = { vis? ~ kw_mod ~ ident ~ (mod_inline | ";") }
kw_mod     = @{ "mod" ~ !(ASCII_ALPHANUMERIC | "_") }
mod_inline = { "{" ~ item* ~ "}" }

// `[pub] const NAME: TYPE = EXPR;`
const_item = { vis? ~ "const" ~ ident ~ ":" ~ f_typeref ~ "=" ~ f_expr ~ ";" }

// `[pub] struct Name { [pub] field: Type [= reset], ... }` — inline reset values.
struct_item  = { attr* ~ vis? ~ "struct" ~ ident ~ "{" ~ (struct_field ~ ("," ~ struct_field)* ~ ","?)? ~ "}" }
struct_field = { vis? ~ ident ~ ":" ~ f_typeref ~ ("=" ~ f_expr)? }

// `[pub] enum Name { Variant [= disc], ... }` with an optional `#[encoding(...)]`.
// Variants are as visible as the enum, so they carry no per-variant `pub`.
enum_item    = { attr* ~ vis? ~ "enum" ~ ident ~ "{" ~ (enum_variant ~ ("," ~ enum_variant)* ~ ","?)? ~ "}" }
enum_variant = { ident ~ ("=" ~ f_expr)? }

// `impl Name { fn ... }` (an impl block itself carries no visibility; its
// methods do, via `fn_item`).
impl_item = { "impl" ~ ident ~ "{" ~ fn_item* ~ "}" }

// `[#[attr]] [pub] [pipeline|multiplex] fn name(params) -> Type { block }`. The
// clock-root carries `#[clock(domain = …)]`; combinational sub-steps carry none.
// A function color (DESIGN §3) precedes `fn`; absent = plain combinational.
fn_item     = { attr* ~ vis? ~ fn_color? ~ "fn" ~ ident ~ "(" ~ (param ~ ("," ~ param)* ~ ","?)? ~ ")" ~ "->" ~ f_typeref ~ f_block }
fn_color    = @{ ("pipeline" | "multiplex") ~ !(ASCII_ALPHANUMERIC | "_") }
param       = { self_param | typed_param }
self_param  = @{ "self" ~ !(ASCII_ALPHANUMERIC | "_") }
typed_param = { ident ~ ":" ~ f_typeref }

// Attributes: `#[name]` or `#[name(arg, key = value, ...)]`.
attr      = { "#[" ~ ident ~ attr_args? ~ "]" }
attr_args = { "(" ~ attr_arg ~ ("," ~ attr_arg)* ~ ")" }
attr_arg  = { ident ~ ("=" ~ attr_val)? }
attr_val  = { ident | literal }

// A block is a sequence of statements then a tail expression (its value). A
// `pipeline fn` body additionally uses `yield` statements as stage boundaries
// (DESIGN §3.1); `yield` is grammatically allowed in any block and restricted to
// pipelines by a later semantic pass.
f_block = { "{" ~ (f_let | f_yield)* ~ f_expr ~ "}" }
f_let   = { "let" ~ f_pattern ~ (":" ~ f_typeref)? ~ "=" ~ f_expr ~ ";" }
// `yield;` is a bare stage barrier (live locals auto-register); `yield expr;`
// additionally taps `expr` out at that stage (reserved; not yet lowered).
f_yield  = { kw_yield ~ f_expr? ~ ";" }
kw_yield = @{ "yield" ~ !(ASCII_ALPHANUMERIC | "_") }

// Patterns (let bindings and match arms). `f_path_pat` needs at least one `::`
// so a bare name falls through to `f_binding`; `f_wildcard` needs a word
// boundary so `_tens_wrap` binds rather than matching the `_` wildcard.
f_pattern   = { f_tuple_pat | f_wildcard | f_lit_pat | f_path_pat | f_binding }
f_tuple_pat = { "(" ~ f_pattern ~ ("," ~ f_pattern)* ~ ","? ~ ")" }
f_wildcard  = @{ "_" ~ !(ASCII_ALPHANUMERIC | "_") }
f_lit_pat   = { literal }
f_path_pat  = { ident ~ ("::" ~ ident)+ }
f_binding   = { ident }

// Type references. Fixed-point `uI.F` / `iI.F` (DESIGN §6.1) is admitted in the
// scalar form; the dotted frac requires a digit so it never clashes with `..`
// or member access. Order matters: scalar before named so `u4` is not a name.
f_typeref   = { f_array_ty | f_tuple_ty | f_scalar_ty | ident }
f_array_ty  = { "[" ~ f_typeref ~ ";" ~ f_expr ~ "]" }
f_tuple_ty  = { "(" ~ f_typeref ~ ("," ~ f_typeref)+ ~ ","? ~ ")" }
f_scalar_ty = @{ ("u" | "i") ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }

// Functional expression grammar, lowest precedence first. Mirrors the legacy
// precedence but adds `as` casts, postfix (field/call/index), and the richer
// primaries (struct literals, paths, match, tuples, arrays).
f_expr = { f_or }
f_or   = { f_xor ~ (or_op ~ f_xor)* }
f_xor  = { f_and ~ (xor_op ~ f_and)* }
f_and  = { f_eq ~ (and_op ~ f_eq)* }
f_eq   = { f_rel ~ (eq_op ~ f_rel)* }
f_rel  = { f_add ~ (rel_op ~ f_add)* }
f_add  = { f_mul ~ (add_op ~ f_mul)* }
f_mul  = { f_cast ~ (mul_op ~ f_cast)* }

// `expr as Type mode` — mode-named narrowing cast (DESIGN §6.3). Binds tighter
// than the binary operators, looser than unary/postfix (as in Rust). Exactly
// one mode-cast is allowed; to chain (a double narrowing), parenthesize the
// inner cast: `(x as u8 wrap) as u4 trunc`.
f_cast      = { f_unary ~ ("as" ~ f_typeref ~ f_cast_mode)? }
f_cast_mode = @{ ("sat" | "wrap" | "trunc" | "round") ~ !(ASCII_ALPHANUMERIC | "_") }

f_unary   = { unary_op* ~ f_postfix }
f_postfix = { f_primary ~ (f_dot | f_call | f_index)* }
// `.field` or `.method(args)` — distinguished by the presence of `f_args`.
f_dot   = { "." ~ ident ~ f_args? }
f_call  = { f_args }
f_index = { "[" ~ f_expr ~ "]" }
f_args  = { "(" ~ (f_expr ~ ("," ~ f_expr)* ~ ","?)? ~ ")" }

// Primaries. `f_struct_lit` requires ≥1 field and `f_field_init` guards the
// colon (`!":"`) so a path scrutinee (`match cmd {`) or bare condition
// (`if flag {`) never mis-parses the following block as struct fields. This is
// the pragmatic disambiguation of the classic struct-literal-in-condition
// ambiguity; the error-tolerant LSP parser (DESIGN §7.1) will harden it.
// `f_block` is admitted here (not only as an `if` branch / fn body) so a block
// is a first-class expression: a `let` initializer, a match-arm body, a struct
// field value, a call argument, etc. It starts with `{`, disjoint from every
// other alternative, so there is no ambiguity.
f_primary = { f_match | f_if | f_block | f_struct_lit | f_path | f_group_or_tuple | f_array | literal | ident }

f_if         = { "if" ~ f_expr ~ f_block ~ "else" ~ (f_if | f_block) }
f_match      = { "match" ~ f_expr ~ "{" ~ (f_match_arm ~ ("," ~ f_match_arm)* ~ ","?)? ~ "}" }
f_match_arm  = { f_pattern ~ "=>" ~ f_expr }
f_struct_lit = { ident ~ "{" ~ f_field_init ~ ("," ~ f_field_init)* ~ ","? ~ "}" }
f_field_init = { ident ~ ":" ~ !":" ~ f_expr }
f_path       = { ident ~ ("::" ~ ident)+ }
// A parenthesized group (one element) or a tuple (two or more).
f_group_or_tuple = { "(" ~ f_expr ~ ("," ~ f_expr)* ~ ","? ~ ")" }
f_array          = { "[" ~ (f_expr ~ ("," ~ f_expr)* ~ ","?)? ~ "]" }
