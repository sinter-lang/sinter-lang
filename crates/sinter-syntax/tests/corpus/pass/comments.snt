// Line and block comments are whitespace-equivalent and must not appear in the
// parsed AST. This file is dense with both to prove they are stripped.
struct Commented /* trailing block */ {
    pub b: u1 = 0, // an output
    /* a
       multi-line
       block comment */
}

impl Commented {
    fn step(self, a: u1) -> Commented {
        Commented { b: a } // drive the output
    }
}
