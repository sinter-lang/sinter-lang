// Hexadecimal (`0x`) and decimal integer literals. Both fold to the same
// untyped `Literal` value in the AST; width is resolved later from context.
struct Masks {
    saved: u16 = 0xBEEF,
}

impl Masks {
    fn step(self, a: u16) -> (Masks, u16) {
        (Masks { saved: a & 0x00FF }, (self.saved + 16) as u16 wrap)
    }
}
