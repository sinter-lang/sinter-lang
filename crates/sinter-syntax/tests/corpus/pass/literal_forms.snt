// Integer literal forms (DESIGN §6.10): decimal with `_` separators, hex,
// binary, and binary with a Rust-style width suffix. A suffixed literal is
// range-checked and desugars to a `wrap` cast to its suffix type.
const A: u32 = 1_000_000;
const B: u8 = 0xFF;
const C: u8 = 0b1010_1010;
const D: u7 = 0b0111111_u7;
