Program {
    modules: [
        Module {
            name: "counter",
            clock_domain: "sys",
            ports: [
                Port {
                    dir: In,
                    name: "en",
                    ty: Uint(
                        1,
                    ),
                    pos: Pos {
                        line: 4,
                        col: 5,
                    },
                },
                Port {
                    dir: Out,
                    name: "count",
                    ty: Uint(
                        8,
                    ),
                    pos: Pos {
                        line: 5,
                        col: 5,
                    },
                },
            ],
            regs: [
                Reg {
                    name: "value",
                    ty: Uint(
                        8,
                    ),
                    init: Literal(
                        0,
                    ),
                    pos: Pos {
                        line: 7,
                        col: 5,
                    },
                },
            ],
            lets: [],
            assigns: [
                Assign {
                    target: "value",
                    kind: NextState,
                    value: If {
                        cond: Ident(
                            "en",
                        ),
                        then: Binary {
                            op: Add,
                            lhs: Ident(
                                "value",
                            ),
                            rhs: Literal(
                                1,
                            ),
                        },
                        els: Ident(
                            "value",
                        ),
                    },
                    pos: Pos {
                        line: 9,
                        col: 5,
                    },
                },
                Assign {
                    target: "count",
                    kind: Drive,
                    value: Ident(
                        "value",
                    ),
                    pos: Pos {
                        line: 10,
                        col: 5,
                    },
                },
            ],
            pos: Pos {
                line: 3,
                col: 1,
            },
        },
    ],
    items: [],
}
