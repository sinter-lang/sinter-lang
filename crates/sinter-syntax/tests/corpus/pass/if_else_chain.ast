                    value: If {
                        cond: Ident(
                            "a",
                        ),
                        then: Literal(
                            1,
                        ),
                        els: If {
                            cond: Ident(
                                "b",
                            ),
                            then: Literal(
                                2,
                            ),
                            els: Literal(
                                0,
                            ),
                        },
                    },
                    pos: Pos {
