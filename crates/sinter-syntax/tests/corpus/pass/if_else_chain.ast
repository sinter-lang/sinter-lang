                        1,
                    ),
                    pos: Pos {
                        line: 4,
                        col: 5,
                    },
                },
                Port {
                    dir: In,
                    name: "b",
                    ty: Uint(
                        1,
                    ),
                    pos: Pos {
                        line: 5,
                        col: 5,
                    },
                },
                Port {
                    dir: Out,
                    name: "sel",
                    ty: Uint(
