pub fn seven_seg(d: u4) -> u7 {
    match d {
        0 => 0b0111111_u7,
        1 => 0b0000110_u7,
        2 => 0b1011011_u7,
        3 => 0b1001111_u7,
        4 => 0b1100110_u7,
        5 => 0b1101101_u7,
        6 => 0b1111101_u7,
        7 => 0b0000111_u7,
        8 => 0b1111111_u7,
        9 => 0b1101111_u7,
        _ => 0b0000000_u7,
    }
}
